# Server Configuration
PORT=5000
NODE_ENV=development
DB_PATH=data/mailer.db

# Provider Mode: "GRAPH_API" or "AZURE_ACS"
DEFAULT_PROVIDER=GRAPH_API

# Microsoft Entra ID (Graph API Credentials)
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret

# Default Sender Mailbox (Must be a licensed or shared mailbox in this tenant)
DEFAULT_SENDER_EMAIL=dr.reetashah@theparipexjournal.com

# Pacing & Limits
GLOBAL_SEND_INTERVAL_MS=2500
DEFAULT_ACCOUNT_DAILY_LIMIT=500
ACCOUNT_COOLDOWN_SECONDS=60

# Optional: Azure Communication Services (ACS) Connection String
# (If using pure ACS Pay-As-You-Go without M365 license)
AZURE_COMMUNICATION_CONNECTION_STRING=
ACS_SENDER_EMAIL=DoNotReply@journalparipex.com

# Mailgun REST API Configuration
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=your-mailgun-sending-domain.com
MAILGUN_HOST=https://api.mailgun.net
MAILGUN_SENDER_EMAIL=newsletter@your-mailgun-sending-domain.com

# Oracle Cloud Infrastructure (OCI) Object Storage (S3-Compatible)
OCI_S3_ACCESS_KEY=your-oci-customer-secret-access-key
OCI_S3_SECRET_KEY=your-oci-customer-secret-key
OCI_S3_NAMESPACE=your-tenancy-namespace
OCI_S3_BUCKET=your-bucket-name
OCI_S3_REGION=ap-mumbai-1

